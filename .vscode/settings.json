{
    "files.associations": {
        "*.json5": "jsonc",
        "**/provision/terraform/**/*.tf": "terraform"
    },
    "yaml.schemas": {
        "Kubernetes": "cluster/*.y*ml",
        "https://taskfile.dev/schema.json": ".taskfiles/*.y*ml",
        ".vscode/app-config.schema.json": "**/app-config.yaml"
    },
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs":"active",
    "editor.hover.delay": 1500
}
