# Local development secrets — copy this file to devcontainer.env and fill in the values.
# devcontainer.env is gitignored. In GitHub Codespaces, set these as repository secrets instead
# (Settings > Secrets and variables > Codespaces).
#
# Format: one NAME=value per line, nothing after the value. Docker keeps quotes and a trailing
# "# comment" as part of the value, and the service then rejects the token.
# The file is read only when the container is created: after a change, run "Rebuild Container".
#
# Terraform Cloud token (manages Cloudflare entities)
# TERRAFORM_TOKEN=
# Bitwarden Secrets Manager token
# BWS_ACCESS_TOKEN=
# GitHub PAT
# GITHUB_TOKEN=
# WireGuard client private key (local: WireGuard is managed by the host OS, not needed here normally)
# WG_PRIVATE_KEY=
# WireGuard server endpoint host:port (e.g. vpn.example.com:51820)
# WG_ENDPOINT=
