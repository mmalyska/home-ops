#shellcheck disable=SC2148,SC2155
# Only when the file exists: in the Coder workspace kubectl uses the in-cluster configuration.
[ -f ~/.kube/config ] && export KUBECONFIG=$(expand_path ~/.kube/config)
export XDG_CONFIG_HOME=$(expand_path ~/.config)
export TALOSCONFIG=${TALOSCONFIG:-${PWD}/provision/talos/clusterconfig/talosconfig}
export HOMEBREW_GITHUB_API_TOKEN=${GITHUB_TOKEN}
# Load the project's secrets into the environment, one `export` per secret, from JSON. Not `export $(... | xargs)`: that
# breaks on a value with a quote or a newline, silently drops every secret after it, and a bare `export` prints the whole
# environment. Skipped on purpose: SSH_SIGNING_KEY (the workspace loads it into an ssh-agent and it must never be an
# environment variable), any multi-line value, and any key that is not a valid variable name.
if bws_json="$(bws secret list "${BWS_PROJECT_ID:-561fda11-77b5-43bd-8192-b3fe00d01958}" -o json 2>/dev/null)" \
  && printf '%s' "${bws_json}" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1; then
  while IFS= read -r -d '' bws_entry; do
    export "${bws_entry%%=*}=${bws_entry#*=}"
  done < <(printf '%s' "${bws_json}" | jq -j '.[]
    | select(.key | test("^[A-Za-z_][A-Za-z0-9_]*$"))
    | select(.key != "SSH_SIGNING_KEY")
    | select(.value | contains("\n") | not)
    | .key + "=" + .value + "\u0000"')
else
  log_status "bws returned no secrets (missing BWS_ACCESS_TOKEN or no access); continuing without them"
fi
unset bws_json bws_entry
