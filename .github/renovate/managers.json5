{
  "argocd": {
    "fileMatch": ["cluster/.+\\.ya?ml$"],
  },
  "helm-values": {
    "fileMatch": ["cluster/.+\\.ya?ml$"],
  },
  "kubernetes": {
    "fileMatch": ["cluster/.+\\.ya?ml$"],
  },
  // The docs dependency lock is generated by uv from requirements.in; the manager reads the
  // compile command from the lock header. See docs/src/contributing/docs-build.md.
  "pip-compile": {
    "managerFilePatterns": ["/^\\.github\\/mkdocs\\/requirements\\.txt$/"],
  },
  // Keep the default pip_requirements handling for every other requirements file, but not for the
  // docs sources: pip-compile already owns them, and running both managers duplicates updates.
  "pip_requirements": {
    "ignorePaths": [".github/mkdocs/**"],
  },
  "packageRules": [
    {
      "description": "Maintain indirect docs lock entries. Indirect updates are disabled by default.",
      "matchManagers": ["pip-compile"],
      "matchDepTypes": ["indirect"],
      "enabled": true,
    },
  ],
}
