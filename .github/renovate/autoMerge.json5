{
  "packageRules": [
    {
      "description": "Wait 3 days before GitHub release and tag updates",
      "matchDatasources": ["github-releases", "github-tags"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Wait 3 days before cosign updates",
      "matchDatasources": ["github-releases", "github-tags"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "sigstore/cosign"
      ],
      "matchFileNames": [".github/**"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
