#!/bin/sh
# worktree-preflight: classify a path as primary checkout, linked worktree, or something else.
# The single source of the worktree-first logic. POSIX sh and git only: no jq, no awk, no sed.
#
# Usage: worktree-preflight [--path <p>] [--hook] [--json] [--human-only]
#
#   --path <p>     classify <p> (default: the current directory). A path that does not exist yet
#                  is classified by its nearest existing parent.
#   --hook         commit mode: also refuse when the checked-out branch is the default branch.
#   --json         print the result as one JSON object instead of key=value lines.
#   --human-only   a break-glass reason is honoured only when a controlling terminal is present.
#
# Output: kind, branch, default_branch, dirty, detached.
#   kind: primary | worktree | submodule | git-internal | bare | not-repo
#
# Exit codes:
#   0  allowed (worktree, submodule, git-internal, not-repo), or break-glass used and logged
#   2  usage error
#   3  refused: primary checkout, bare repository, or (with --hook) the default branch
#   4  cannot classify (git missing, git failed inside a repository, log unwritable): refused.
#      The guard fails closed: a broken tool never turns into permission.
#
# Break-glass (a human only): HOME_OPS_BREAK_GLASS="<reason>" in the environment. A non-empty reason
# turns exit 3 into exit 0, prints a warning, and appends one line to
# <git-common-dir>/break-glass.log. An empty or blank reason does nothing. If the line cannot be
# written the bypass is refused (exit 4).
#
# Writes nothing to the repository except that log line. Runs no other script and no network call.

set -u
export GIT_OPTIONAL_LOCKS=0   # status must not refresh the index: this script writes nothing
# Classify from the path, never from an inherited repository selection.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM

PROG=worktree-preflight

usage() {
  printf 'usage: %s [--path <path>] [--hook] [--json] [--human-only]\n' "$PROG" >&2
  exit "${1:-2}"
}

TARGET='' HOOK=0 JSON=0 HUMAN_ONLY=0
while [ $# -gt 0 ]; do
  case $1 in
    --path) [ $# -ge 2 ] || usage 2; TARGET=$2; shift 2 ;;
    --hook) HOOK=1; shift ;;
    --json) JSON=1; shift ;;
    --human-only) HUMAN_ONLY=1; shift ;;
    -h|--help) usage 0 ;;
    *) usage 2 ;;
  esac
done
if [ -z "$TARGET" ]; then TARGET=$(pwd -P 2>/dev/null) || TARGET=.; fi

die4() { printf '%s: %s (refusing: fail closed)\n' "$PROG" "$1" >&2; exit 4; }

command -v git >/dev/null 2>&1 || die4 'git not found'

# Walk up to the nearest existing directory, so a file that does not exist yet is classified by its
# intended parent.
nearest_dir() {
  d=$1
  [ -n "$d" ] || { printf '.'; return; }
  case $d in */) [ "$d" = / ] || d=${d%/} ;; esac
  while [ ! -d "$d" ]; do
    case $d in
      /|.|'') break ;;
      */*) d=${d%/*}; [ -n "$d" ] || d=/ ;;
      *) d=. ;;
    esac
  done
  printf '%s' "$d"
}

# 0 if some ancestor of $1 has a .git entry (file or directory).
has_git_ancestor() {
  a=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  while :; do
    [ -e "$a/.git" ] && return 0
    [ "$a" = / ] && return 1
    a=${a%/*}; [ -n "$a" ] || a=/
  done
}

KIND='' BRANCH='' DEFAULT_BRANCH='' DIRTY=false DETACHED=false COMMON='' DIR=''

classify() {
  DIR=$(nearest_dir "$1")
  abs=$(cd "$DIR" 2>/dev/null && pwd -P) || die4 "cannot enter $DIR"
  DIR=$abs

  if ! gitdir=$(git -C "$DIR" rev-parse --absolute-git-dir 2>/dev/null); then
    # Not a repository, or git refuses to look (for example "dubious ownership"). Only the first is
    # permission; the second must not read as "not a repo".
    if has_git_ancestor "$DIR"; then die4 "git cannot read the repository at $DIR"; fi
    KIND=not-repo; return
  fi
  gitdir=$(cd "$gitdir" 2>/dev/null && pwd -P) || die4 'cannot resolve the git directory'
  common=$(cd "$DIR" && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P) \
    || die4 'cannot resolve the common git directory'
  COMMON=$common

  # Inside a git directory is not a working-tree write. Checked first: a bare repository's own
  # directory is also its git directory, and that is the bare case below only when git says so.
  if [ "$(git -C "$DIR" rev-parse --is-bare-repository 2>/dev/null)" = true ]; then KIND=bare; return; fi
  case "$DIR/" in
    "$common"/*|"$gitdir"/*) KIND=git-internal; return ;;
  esac

  if [ -n "$(git -C "$DIR" rev-parse --show-superproject-working-tree 2>/dev/null)" ]; then
    KIND=submodule; return
  fi

  if [ "$gitdir" != "$common" ]; then KIND=worktree; else KIND=primary; fi

  if BRANCH=$(git -C "$DIR" symbolic-ref --quiet --short HEAD 2>/dev/null); then :; else
    BRANCH=''; DETACHED=true
  fi
  if [ -n "$(git -C "$DIR" status --porcelain 2>/dev/null)" ]; then DIRTY=true; fi
}

default_branch() {
  b=$(git -C "$DIR" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) && [ -n "$b" ] \
    && { printf '%s' "${b#origin/}"; return; }
  for c in main master; do
    git -C "$DIR" show-ref --verify --quiet "refs/heads/$c" 2>/dev/null && { printf '%s' "$c"; return; }
  done
  printf 'main'
}

classify "$TARGET"
case $KIND in primary|worktree) DEFAULT_BRANCH=$(default_branch) ;; esac

json_escape() {
  in=$1 out=''
  while :; do
    case $in in
      *[\\\"]*)
        pre=${in%%[\\\"]*}; rest=${in#"$pre"}; ch=${rest%"${rest#?}"}
        out=$out$pre\\$ch; in=${rest#?} ;;
      *) out=$out$in; break ;;
    esac
  done
  printf '%s' "$out"
}

print_result() {
  if [ "$JSON" = 1 ]; then
    printf '{"kind":"%s","branch":"%s","default_branch":"%s","dirty":%s,"detached":%s}\n' \
      "$KIND" "$(json_escape "$BRANCH")" "$(json_escape "$DEFAULT_BRANCH")" "$DIRTY" "$DETACHED"
  else
    printf 'kind=%s\nbranch=%s\ndefault_branch=%s\ndirty=%s\ndetached=%s\n' \
      "$KIND" "$BRANCH" "$DEFAULT_BRANCH" "$DIRTY" "$DETACHED"
  fi
}

# Decide. VIOLATION holds the reason, empty when allowed.
VIOLATION=''
case $KIND in
  primary) VIOLATION='this is the primary checkout, which is never a workspace' ;;
  bare) VIOLATION='this is a bare repository, which has no working tree to write in' ;;
  worktree)
    if [ "$HOOK" = 1 ] && [ -n "$BRANCH" ]; then
      case $BRANCH in
        "$DEFAULT_BRANCH"|main|master) VIOLATION="branch '$BRANCH' is the default branch, which is not a place to implement" ;;
      esac
    fi ;;
esac

if [ -z "$VIOLATION" ]; then print_result; exit 0; fi

print_result
printf '%s: %s.\n' "$PROG" "$VIOLATION" >&2
printf 'Create a linked worktree and work there: git worktree add .worktrees/<type>/<slug> -b <type>/<slug> origin/main\n' >&2

# --- break-glass: a human, with a reason, on the record -------------------------------------------
reason=${HOME_OPS_BREAK_GLASS:-}
trimmed=${reason#"${reason%%[![:space:]]*}"}
if [ -z "$trimmed" ]; then
  [ -z "$reason" ] || printf '%s: HOME_OPS_BREAK_GLASS has no reason; ignored.\n' "$PROG" >&2
  exit 3
fi
if [ "$HUMAN_ONLY" = 1 ] && ! ( : </dev/tty ) 2>/dev/null; then
  printf '%s: break-glass is for a person at a terminal; no terminal here, so it is ignored.\n' "$PROG" >&2
  exit 3
fi

[ -n "$COMMON" ] || die4 'no git directory to hold the break-glass log'
clean=$(printf '%s' "$trimmed" | tr '\n\r\t' '   ') || die4 'cannot sanitize the break-glass reason'
now=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || die4 'cannot read the clock for the break-glass log'
who=$(id -un 2>/dev/null) || die4 'cannot read the user name for the break-glass log'
printf '%s\t%s\t%s\t%s\t%s\n' "$now" "$who" "$DIR" "$KIND:${BRANCH:-detached}" "$clean" >> "$COMMON/break-glass.log" \
  || die4 "cannot append to $COMMON/break-glass.log"

printf '%s: BREAK-GLASS in use (%s). Logged to %s/break-glass.log.\n' "$PROG" "$clean" "$COMMON" >&2
exit 0
