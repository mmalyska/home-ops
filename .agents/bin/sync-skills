#!/usr/bin/env bash
# sync-skills: generate the Claude Code adapter .claude/skills from the canonical .agents/skills.
#
#   sync-skills [--root DIR]           regenerate DIR/.claude/skills (default: this repository)
#   sync-skills --check [--root DIR]   change nothing; exit 1 when the mirror differs from the source
#
# Ownership: .agents/skills is the only place a skill is edited. .claude/skills is generated output
# (a real directory, not a symlink, so it needs no symlink support on any host) and carries the marker
# file GENERATED. Output is deterministic: the mirror is a byte copy of the source, file modes kept,
# plus a fixed marker; no timestamp, host or user name is written. Re-running changes nothing.
# Touches only DIR/.claude/skills; never git, the network or the cluster.
# Exit: 0 = in sync (or regenerated), 1 = drift (--check) or invalid source, 2 = usage error.
set -uo pipefail
export LC_ALL=C

SRC_REL=".agents/skills"
DST_REL=".claude/skills"
MARKER="GENERATED"
MARKER_TEXT="This directory is generated by .agents/bin/sync-skills from .agents/skills.
Do not edit it. Edit .agents/skills, then run: .agents/bin/sync-skills
CI fails when this directory differs from .agents/skills.
"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
check=0
while [ $# -gt 0 ]; do
  case "$1" in
    --check) check=1 ;;
    --root) [ $# -ge 2 ] || { echo "sync-skills: --root needs a directory" >&2; exit 2; }; root="$2"; shift ;;
    *) echo "usage: sync-skills [--check] [--root DIR]" >&2; exit 2 ;;
  esac
  shift
done
root="$(cd "$root" 2>/dev/null && pwd)" || { echo "sync-skills: no such directory" >&2; exit 2; }
src="$root/$SRC_REL"
dst="$root/$DST_REL"

if [ -L "$src" ] || [ ! -d "$src" ]; then
  echo "sync-skills: $SRC_REL must be a real directory" >&2; exit 1
fi
if [ -n "$(find "$src" -type l -print -quit)" ]; then
  echo "sync-skills: $SRC_REL must not contain symlinks" >&2; exit 1
fi

# manifest <dir>: one line per file, relative path, mode and content hash; the marker is excluded.
manifest() {
  (cd "$1" && find . -type f ! -path "./$MARKER" -print0 | sort -z |
    while IFS= read -r -d '' f; do
      printf '%s %s %s\n' "$f" "$(stat -c '%a' "$f")" "$(sha256sum "$f" | cut -d' ' -f1)"
    done)
}
# tree_entries <dir>: directories and non-file entries, so an empty or extra directory counts as drift.
tree_entries() { (cd "$1" && find . ! -type f ! -path . -print | sort); }

drift() {
  local bad=0 want have
  if [ -L "$dst" ] || [ ! -d "$dst" ]; then echo "$DST_REL is missing or is a symlink"; return 1; fi
  if [ -n "$(find "$dst" -type l -print -quit)" ]; then echo "$DST_REL contains a symlink"; bad=1; fi
  if [ "$(cat "$dst/$MARKER" 2>/dev/null; printf x)" != "${MARKER_TEXT}x" ]; then echo "$DST_REL/$MARKER is missing or changed"; bad=1; fi
  want="$(manifest "$src")"; have="$(manifest "$dst")"
  if [ "$want" != "$have" ]; then
    echo "file content, mode or file list differs:"
    diff <(printf '%s\n' "$want") <(printf '%s\n' "$have") | sed 's/^/  /'
    bad=1
  fi
  if [ "$(tree_entries "$src")" != "$(tree_entries "$dst")" ]; then
    echo "directory list differs:"
    diff <(tree_entries "$src") <(tree_entries "$dst") | sed 's/^/  /'
    bad=1
  fi
  return "$bad"
}

if [ "$check" -eq 1 ]; then
  if out="$(drift)"; then echo "sync-skills: $DST_REL matches $SRC_REL"; exit 0; fi
  printf '%s\n' "$out"
  echo "sync-skills: $DST_REL is out of sync with $SRC_REL; run .agents/bin/sync-skills" >&2
  exit 1
fi

mkdir -p "$root/.claude"
rm -rf "$dst"
cp -pR "$src" "$dst"
printf '%s' "$MARKER_TEXT" > "$dst/$MARKER"
chmod 644 "$dst/$MARKER"
echo "sync-skills: wrote $DST_REL from $SRC_REL"
