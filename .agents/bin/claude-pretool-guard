#!/bin/sh
# claude-pretool-guard: Claude Code PreToolUse hook for this repository.
# Reads the hook JSON on stdin and answers with a permissionDecision. POSIX sh and git only: no jq,
# so a missing JSON tool cannot turn the guard off. Classification is delegated to worktree-preflight.
#
#   Edit | Write | NotebookEdit  deny when the target is in the primary checkout (or a bare repo);
#                                deny a write into a git directory (hooks, config, refs), and into a
#                                submodule of the primary checkout (worktree-preflight --write);
#                                deny when the target cannot be determined (fail closed).
#   Bash                         deny commands that set or use a bypass: HOME_OPS_BREAK_GLASS,
#                                CLAUDE_ALLOW_MAIN_EDITS, --no-verify, core.hooksPath, SKIP=.
#                                This is a string match on the command: it stops the honest and the
#                                careless, not a determined obfuscation. Review and CI are the boundary.
#   anything else                allowed, once the input has been read as a JSON object with a tool_name.
#   unreadable input             denied: a missing tool_name, input that is not a JSON object, or a changed
#                                event format must never switch the guard off.
#
# Always exits 0 with a decision on stdout. The settings.json command wrapper turns any other exit
# (crash, missing file) into exit 2, which Claude Code treats as a block.
# A human who launched Claude Code with HOME_OPS_BREAK_GLASS="<reason>" passes the file-tool check;
# worktree-preflight logs it. The agent cannot change Claude Code's own environment.

set -u
HERE=${0%/*}
[ "$HERE" != "$0" ] || HERE=.

INPUT=$(cat) || INPUT=''

esc() { # JSON string escape for backslash and double quote
  in=$1 out=''
  while :; do
    case $in in
      *[\\\"]*)
        pre=${in%%[\\\"]*}; rest=${in#"$pre"}; ch=${rest%"${rest#?}"}
        out=$out$pre\\$ch; in=${rest#?} ;;
      *) out=$out$in; break ;;
    esac
  done
  printf '%s' "$out"
}

decide() { # reason -> deny, exit 0
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$(esc "$1")"
  exit 0
}

# json_str <key>: JV gets the first string value of "key". 0 found, 1 absent, 2 malformed or unsupported.
JV=''
# shellcheck disable=SC1003  # the quoted backslashes below are intentional JSON escapes
json_str() {
  k="\"$1\""
  case $INPUT in *"$k"*) ;; *) return 1 ;; esac
  rest=${INPUT#*"$k"}
  rest=${rest#"${rest%%[![:space:]]*}"}
  case $rest in :*) rest=${rest#:} ;; *) return 2 ;; esac
  rest=${rest#"${rest%%[![:space:]]*}"}
  case $rest in \"*) rest=${rest#\"} ;; *) return 2 ;; esac
  out=''
  while :; do
    case $rest in
      '') return 2 ;;
      \"*) JV=$out; return 0 ;;
      '\\'*) out=$out'\'; rest=${rest#??} ;;
      '\"'*) out=$out'"'; rest=${rest#??} ;;
      '\/'*) out=$out/; rest=${rest#??} ;;
      '\'*) return 2 ;;
      *) chunk=${rest%%[\"\\]*}; out=$out$chunk; rest=${rest#"$chunk"} ;;
    esac
  done
}

# Shell string scanning is quadratic, so only inputs up to MAX_SCAN bytes get the balance check; a larger
# input still has to be a '{...}' object that yields a tool_name. A truncated payload that large is not expected.
MAX_SCAN=32768
# balanced <input>: 0 when braces and brackets balance outside strings and every string is closed.
# shellcheck disable=SC2295  # BR is meant to be a pattern
balanced() {
  BR='[][{}]'
  rest=$INPUT depth=0
  while [ -n "$rest" ]; do
    chunk=${rest%%\"*}; rest=${rest#"$chunk"}
    while :; do
      case $chunk in
        *[][{}]*)
          pre=${chunk%%$BR*}; chunk=${chunk#"$pre"}; ch=${chunk%"${chunk#?}"}; chunk=${chunk#?}
          case $ch in '{'|'[') depth=$((depth + 1)) ;; *) depth=$((depth - 1)); [ "$depth" -ge 0 ] || return 1 ;; esac ;;
        *) break ;;
      esac
    done
    case $rest in
      \"*)
        rest=${rest#\"}
        while :; do
          case $rest in
            '') return 1 ;;
            \\?*) rest=${rest#??} ;;
            \\*) return 1 ;;
            \"*) rest=${rest#\"}; break ;;
            *) skip=${rest%%[\"\\]*}; rest=${rest#"$skip"} ;;
          esac
        done ;;
    esac
  done
  [ "$depth" = 0 ]
}

gtrim=${INPUT#"${INPUT%%[![:space:]]*}"}
gtrim=${gtrim%"${gtrim##*[![:space:]]}"}
case $gtrim in
  '{'*'}') [ "${#INPUT}" -gt "$MAX_SCAN" ] || balanced || decide 'worktree guard: the hook input is not valid JSON (unbalanced), so the call is blocked (fail closed).' ;;
  *) decide 'worktree guard: the hook input is not a JSON object, so the call is blocked (fail closed).' ;;
esac
json_str tool_name; rc=$?
[ "$rc" = 0 ] && [ -n "$JV" ] || decide 'worktree guard: could not read tool_name from the hook input, so the call is blocked (fail closed).'
TOOL=$JV
CWD=''; json_str cwd && CWD=$JV

case $TOOL in
  Bash)
    json_str command; rc=$?
    [ "$rc" = 0 ] || decide 'worktree guard: could not read the Bash command from the hook input, so it is blocked (fail closed).'
    case $JV in
      *HOME_OPS_BREAK_GLASS*|*CLAUDE_ALLOW_MAIN_EDITS*|*--no-verify*|*core.hooksPath*|*SKIP=*)
        decide 'worktree guard: this command sets or uses a bypass (HOME_OPS_BREAK_GLASS, CLAUDE_ALLOW_MAIN_EDITS, --no-verify, core.hooksPath or SKIP=). Break-glass is for a person, set before the session starts; an agent must not use it or skip hooks. Create a worktree instead: git worktree add .worktrees/<type>/<slug> -b <type>/<slug> origin/main' ;;
    esac
    exit 0 ;;
  Edit|Write) key=file_path ;;
  NotebookEdit) key=notebook_path ;;
  *) exit 0 ;;
esac

json_str "$key"; rc=$?
[ "$rc" = 0 ] && [ -n "$JV" ] || decide "worktree guard: could not read $key from the $TOOL input, so the write is blocked (fail closed)."
target=$JV
case $target in
  /*) ;;
  *) [ -n "$CWD" ] || decide 'worktree guard: relative path without a working directory, so the write is blocked (fail closed).'
     target=$CWD/$target ;;
esac

[ -x "$HERE/worktree-preflight" ] || decide 'worktree guard: worktree-preflight is missing or not executable, so the write is blocked (fail closed).'
"$HERE/worktree-preflight" --write --path "$target" >/dev/null 2>&1
rc=$?
case $rc in
  0) exit 0 ;;
  3) decide "$TOOL on $target is blocked: it is in the primary checkout (or a submodule of it) or inside a git directory, which is never a workspace. Create a worktree and redo the write there: git worktree add .worktrees/<type>/<slug> -b <type>/<slug> origin/main. Do not set HOME_OPS_BREAK_GLASS or CLAUDE_ALLOW_MAIN_EDITS yourself." ;;
  *) decide "worktree guard: the preflight could not classify $target (exit $rc), so the write is blocked (fail closed)." ;;
esac
